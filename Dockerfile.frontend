# ==============================================================================
# Etapa 1: build — compila el frontend Vite/React a estáticos (dist/)
# ==============================================================================
FROM node:20-bookworm-slim AS build

WORKDIR /app/frontend

# Cachear la instalación de dependencias por separado del código fuente
COPY frontend/package.json ./
RUN npm install --no-audit --no-fund

COPY frontend/ ./

# Vite construye a dist/ por defecto (no build/ como CRA)
RUN npm run build

# ==============================================================================
# Etapa 2: runtime — sirve los estáticos con nginx
# ==============================================================================
FROM nginx:alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html

# nginx escucha en el 80 adentro del contenedor; el mapeo "3000:80"
# en docker-compose.yml es lo que lo sigue exponiendo en el puerto
# 3000 de siempre hacia afuera.
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
